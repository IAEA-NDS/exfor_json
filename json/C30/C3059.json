  "experimental_conditions": {
    "001": {
      "0": {
        "detector": [
          {
            "x4_code": "(HE3SP,D4PI)",
            "free_txt": [
              " 4pi neutron detector with a polyethylene",
              "moderator (30.5x30.5x33 cm3) and 5% borated",
              "polyethylene shielding (5 cm). The polyethylene",
              "moderator houses two concentric rings of 3He",
              "proportional counters, containing a total of 16",
              "detectors. The polyethylene moderates neutrons to",
              "thermal energies, which are then detected through the",
              "electrical signal induced by the 3He(n,p)3H reaction."
            ]
          }
        ],
        "facility": [
          {
            "x4_code": "(ACCEL,1USASRF)",
            "free_txt": [
              " The Compact Accelerator System for",
              "Performing Astrophysical Research (CASPAR) at the",
              "Sanford Underground Research Facility (SURF), in",
              "Lead, South Dakota."
            ]
          }
        ],
        "inc-spect": [
          {
            "x4_code": null,
            "free_txt": [
              "300-700 keV alpha beams from the JN accelerator at",
              "the CASPAR underground laboratory. Beam intensities",
              "of He+ ions ranged between 60-70 microA."
            ]
          }
        ],
        "sample": [
          {
            "x4_code": "(5-B-11,ENR=0.99)",
            "free_txt": [
              " Three thick boron targets were",
              "used. These targets were created by vacuum",
              "evaporation of 99% enriched 11B powder onto a 0.5mm",
              "Ta backing. The target thicknesses were determined by",
              "performing thick-target resonance scans over the",
              "narrow resonance at Ealpha = 606 keV."
            ]
          }
        ]
