  "experimental_conditions": {
    "001": {
      "0": {
        "detector": [
          {
            "x4_code": "(IOCH)",
            "free_txt": [
              " The electrically segmented MUlti Sampling",
              "Ionization Chamber (MUSIC). The anode of MUSIC is",
              "segmented into 18 strips of equal width (1.578 cm)",
              "along the beam axis; the 16 inner strips are",
              "alternatively divided into a short and long section",
              "perpendicular to the beam direction."
            ]
          }
        ],
        "facility": [
          {
            "x4_code": "(LINAC,1USAANL)",
            "free_txt": [
              " The Argonne Tandem Linac Accelerator",
              "System (ATLAS)."
            ]
          }
        ],
        "inc-spect": [
          {
            "x4_code": null,
            "free_txt": [
              "The 88Sr stable beam delivered by ATLAS was selected",
              "for the charge state 16+, an energy of 4.56(3) MeV/u,",
              "and an average intensity of 3*10**4 pps. The beam",
              "rate was kept at this low rate to ensure the",
              "stability of the data acquisition system. Similarly,",
              "the 88Sr beam of the second measurement was 4.55(1)",
              "MeV/u at 3*10**4 pps. Horizontal error bars of",
              "measured cross sections (energy resolution) come from",
              "the width of MUSIC detector strips."
            ]
          }
        ],
        "method": [
          {
            "x4_code": null,
            "free_txt": [
              "Two measurements were performed at ATLAS with the",
              "MUSIC detector, in inverse kinematics, while",
              "following the active target technique."
            ]
          }
        ],
        "sample": [
          {
            "x4_code": null,
            "free_txt": [
              "The MUSIC detector was filled with pure 4He gas at",
              "501 Torr (506 Torr for the second measurement). Two",
              "Ti foils of 1.30(5) mg/cm2 thickness located at the",
              "entrance and exit sides of the detector were used to",
              "hold the gas. The beam energy loss after passing",
              "through the entrance foil was measured to be 45.1(4)",
              "MeV."
            ]
          }
        ]
      }
    },
    "002": {
      "0": {
        "correction": [
          {
            "x4_code": null,
            "free_txt": [
              "Incident beam energy value at effective strip",
              "thickness corrected from the thick-target yield were",
              "deduced from the measurement of the beam energy",
              "losses in the MUSIC detector."
            ]
          }
        ],
