  "experimental_conditions": {
    "001": {
      "0": {
        "detector": [
          {
            "x4_code": "(MAGSP,DRFTC,SI,SCIN)",
            "free_txt": [
              " The Super Enge Split-Pole",
              "Spectrograph (SE-SPS), the focal-plane detector",
              "consisted of a drift chamber with proportional-counter",
              "amplification, the Silicon Array for Branching Ratio",
              "Experiments (SABRE) developed by Louisiana State",
              "University."
            ]
          }
        ],
        "facility": [
          {
            "x4_code": "(VDGT,1USAFSU)",
            "free_txt": [
              " The FN Tandem accelerator of the John",
              "D. Fox Accelerator Laboratory."
            ]
          }
        ],
        "method": [
          {
            "x4_code": "(EDE)",
            "free_txt": [
              " The 3He beam was impinged on a natC target in the",
              " scattering chamber of the SE-SPS. Reaction ejectiles",
              "were momentum-analyzed through the SE-SPS and",
              "detected in a position- and angle- sensitive detector",
              "system in the optical focal plane. Identification of",
              "the desired reaction deuterons was achieved through",
              "the correlation between the particles' energy loss (dE)",
              " through the detector gas and residual energy (E)",
              "deposited in a plastic scintillator. The position",
              "signals were analyzed to reconstruct the excitation",
              "spectra of 13N* through kinematic dispersion."
            ]
          }
        ],
        "sample": [
          {
            "x4_code": null,
            "free_txt": [
              "Run1 target thickness was 100 microg/cm2. Run2 target",
              "thickness was 50 microg/cm2."
            ]
          }
        ]
      }
    },
