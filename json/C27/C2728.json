  "experimental_conditions": {
    "001": {
      "0": {
        "detector": [
          {
            "x4_code": "(SI,PPAC,IOCH)",
            "free_txt": [
              " Three quadrant Si detectors (Micron",
              "Semiconductors MSQ25 type) were positioned",
              "symmetrically with respect to the beam axis at the",
              "distance of 513 mm from the entrance window, and",
              "provided information on the total energy of the",
              "recoil protons. A custom multi-anode position-",
              "sensitive proportional counter (MPPC) was installed",
              "in front of Si detectors to provide identification of",
              "the reaction products. A windowless ionization",
              "chamber (IC) was installed close to the entrance",
              "window to count (for normalization) and identify the",
              "incoming ions."
            ]
          }
        ],
        "err-analys": [
          {
            "x4_code": "(ERR-S)",
            "free_txt": [
