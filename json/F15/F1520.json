    "001": {
      "0": {
        "add-res": [
          {
            "x4_code": null,
            "free_txt": [
              "The thick target yield of 90Nb was calculated based on",
              "the measured cross-sections. For the energy range",
              "60.5->46 MeV the yield of 90Nb is about 36 MBq/(mu-A*h)",
              "An additional 4 MBq/(mu-A*h) 90Nb was obtained during",
              "irradiation of 90Mo (19.6 MBq/(mu*A*h)), it was",
              "calculated for EOB+ 12 h."
            ]
          }
        ],
        "detector": [
          {
            "x4_code": "(HPGE)",
            "free_txt": [
              " ORTEC GEM 35P4 high purity germanium detector",
              "with energy resolution of 850 eV for the 122 keV line",
              "and 1.8 keV for the 1330 keV line was used."
            ]
          }
        ],
        "facility": [
          {
            "x4_code": "(ISOCY,4RUSKUR)",
            "free_txt": [
              " U-150 isochronous cyclotron"
