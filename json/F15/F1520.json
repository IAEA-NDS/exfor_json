        "method": [
          {
            "x4_code": "(STTA,EDEG,GSPEC)",
            "free_txt": [
              " Aluminum foils with thickness",
              "21.84+-0.11 mu-m and 43.7+-0.8 mu-m were used as",
              "degraders."
            ]
          },
          {
            "x4_code": "(ACTIV)",
            "free_txt": [
              " Irradiation was carried out for 30 min. Average",
              "current was 228 nA."
            ]
          }
        ],
        "sample": [
          {
            "x4_code": null,
            "free_txt": [
              "10 metal zirconium foils (purity >99.9%) with the",
              "natural isotopic composition (90Zr - 51.45%, 91Zr -",
              "11.22%, 92Zr - 17.15%, 94Zr -17.38%) were prepared by",
              "a cool rolling. The thickness of all measured Zr foils",
              "amounted to 15.0+-1.5 mu-m. Aluminum (8.4+-0.5 mu-m)",
              "and copper (4.95+-0.10 mu-m) foils were used as beam",
              "monitors."
            ]
          }
