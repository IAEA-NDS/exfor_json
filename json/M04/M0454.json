  "experimental_conditions": {
    "001": {
      "0": {
        "analysis": [
          {
            "x4_code": null,
            "free_txt": [
              "The photoneutron yields at various angles were",
              " normalized for the running time and the average",
              " photon flux during each run. The total absolute",
              " D(gamma,n) reaction cross section measured previously",
              " was used to obtain absolute differential cross",
              " sections. At energies not studied previously an",
              " interpolation using a smooth exponential function",
              " which reproduced the experimental cross sections to",
              " within 0.5% was used."
            ]
          }
        ],
        "correction": [
          {
            "x4_code": null,
            "free_txt": [
              "Correction was introduced to take into account the",
              " change of the detector efficiency with energy."
