  "experimental_conditions": {
    "001": {
      "0": {
        "detector": [
          {
            "x4_code": "(SPEC,PPAC,PROPC,SCIN)",
            "free_txt": [
              " The Split-pole spectrograph",
              " (SPS). The focal plane consists of two position",
              "sensitive avalanche counters, a dE proportionality",
              "counter, and a residual E scintillator."
            ]
          }
        ],
        "facility": [
          {
            "x4_code": "(VDGT,1USATNL)",
            "free_txt": [
              " 10 MV TUNL FN tandem accelerator."
            ]
          }
        ],
        "inc-spect": [
          {
            "x4_code": null,
            "free_txt": [
              "The beam energy was set using a set of high resolution",
              "90-90 dipole magnets, typical beam currents were",
              "100-200 enA of 3He+2."
            ]
          }
        ],
        "method": [
          {
            "x4_code": "(EDE)",
            "free_txt": [
              " The 23Na(3He,d) 24Mg reaction was measured at",
              "angles between 3-21 degrees in steps of 2 degree with",
              "a field of 1.14-1.15 T. Additionally, the elastic",
              "scattering reaction, 23Na(3He,3He) , was measured at",
              "angles between 15-55 degrees in 5 degree steps and 59",
              "degree using fields of 0.75-0.80 T. The solid angle",
              "of the SPS was fixed throughout the experiment at SPS",
              "= 1.00(4) msr. After the reaction products were",
              "momentum to charge analyzed by the spectrograph, they",
              "were detected at the focal plane of the SPS."
            ]
          }
        ],
        "sample": [
          {
            "x4_code": null,
            "free_txt": [
              "NaBr was selected as the target material. Targets",
              "were fabricated by using thermal evaporation to",
              "deposit a layer of NaBr on 22 microg/cm2 thick natC",
              "foils. A total of six targets were placed into the",
              "evaporator, and evaporation was halted once they",
              "reached a thickness of 70 microg/cm2."
            ]
          }
        ],
        "status": [
          {
            "x4_code": "(APRVD)",
            "free_txt": [
              " Approved by  K.Setoodehnia on May 18, 2025."
            ]
          }
        ]
      }
    },
    "002": {
      "0": {
        "analysis": [
          {
            "x4_code": null,
            "free_txt": [
              "A Bayesian DWBA analysis was employed in order to",
              "extract C2S values while accounting for optical model",
              "uncertainties. The differential cross section of each",
              "state was fit simultaneously with the elastic",
              "scattering data in order to infer an overall",
              "normalization. An additional statistical uncertainty",
              "was also estimated separately for the elastic",
              "scattering and transfer data to account for",
              "deficiencies in the reaction theory. Cross sections",
              " (mb/sr) can be derived from the measured yields from",
              "the inferred normalization factor of 0.075 with a 9%",
              "systematic uncertainty. The elastic scattering data",
              "had an additional 15% statistical uncertainty. The",
              "additional uncertainty for the transfer cross",
              "sections varied from state to state, but can be taken",
              "to be 15% as an overly conservative average."
            ]
          }
        ],
        "err-analys": [
          {
            "x4_code": "(ERR-S)",
            "free_txt": [
              " Assumed statistical precision uncertainty:",
              "inferred uncertainty, or uncertainty deduced from the",
              "fit. These were parameters of the fit and were",
              "estimated along with the other parameters of the DWBA",
              "fit."
            ]
          },
          {
            "x4_code": "(ERR-SYS)",
            "free_txt": [
              " Systematic uncertainty."
            ]
          }
        ],
