  "experimental_conditions": {
    "001": {
      "0": {
        "analysis": [
          {
            "x4_code": "(DECAY)",
            "free_txt": [
              " For method B, the delayed-neutron decay",
              "curves were analyzed by a least squares computer code",
              "CLSQ into to components - one with the half-life of",
              "the delayed-neutron precursor and one with an",
              "infinite half-life for the background. Delayed-",
              "neutron emission probabilities (%) from SOLAR",
              "experiments were based on weighted average of methods",
              "A and B."
            ]
          }
        ],
        "correction": [
          {
            "x4_code": null,
            "free_txt": [
              "The half-lives are long compared to the cycle time of",
              "the pulsed beam experiments so it is necessary to",
              "make corrections for buildup from cycle to cycle",
              " (multiple pulsing correction). The energy dependence",
              "of the neutron counter was thoroughly investigated",
              "with photoneutron sources and corrections to the",
              "efficiencies have been made to account for the",
              "delayed-neutron spectra. Corrections were made for",
              "buildup of beta activity in the electron multiplier.",
              "Background peaks due to stable ions were present at",
              "masses 87-89 for which corrections to the precursor",
              "ion count rate had to be made. Typical corrections",
              "amounted to 23% at mass 87, 5% at mass 88, and 8% at",
              "mass 89. No corrections were needed for the I",
              "precursors."
            ]
          }
        ],
        "detector": [
          {
            "x4_code": "(HE3SP)",
            "free_txt": [
              " The neutron counter consisted of 42 3He",
              "counter tubes arranged in three concentric rings in a",
              "large block of polyethylene."
            ]
          }
        ],
        "err-analys": [
          {
            "x4_code": "(DATA-ERR)",
            "free_txt": [
              " The uncertainties shown with the SOLAR",
              "data are dominated by the approximately 7%",
              "uncertainty in the neutron counter efficiencies. The",
              "statistical uncertainties in the counting data were",
              "usually less than 2%."
            ]
          },
          {
            "x4_code": "(ERR-S,,2.)",
            "free_txt": [
              " Statistical uncertainties."
            ]
          },
          {
            "x4_code": "(ERR-SYS)",
            "free_txt": [
              " Neutron counter efficiency."
            ]
          }
        ],
        "facility": [
          {
            "x4_code": "(OLMS,1USABNW)",
            "free_txt": [
              " The online mass spectrometer facility",
              "SOLAR."
            ]
          }
        ],
        "method": [
          {
            "x4_code": "(OLMS,COINC)",
            "free_txt": [
              " The primary method A used in this work",
              "is a direct technique based on simultaneous",
              "determination of the total number of neutrons and the",
              "total number of precursor nuclei from mass separated",
              "samples. The absolute value of Pn depends critically",
              "on the neutron counter efficiency and the ion",
              "counting efficiency. A secondary method B of",
              "determining Pn was also employed in some of the",
              "experiments. This method was based on an equivalent",
              "definition of Pn as the ratio of saturation neutron",
              "activity Asat(n) to saturation beta activity",
              "Asat(beta)."
            ]
          }
        ],
        "rel-ref": [
          {
            "x4_code": "(I,,P.L.Reeder+,J,PR/C,15,2098,1977)",
            "free_txt": [
              " Large",
              "polyethylene-moderated neutron counter."
            ]
          }
        ]
      }
    },
