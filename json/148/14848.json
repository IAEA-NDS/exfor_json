  "experimental_conditions": {
    "001": {
      "0": {
        "detector": [
          {
            "x4_code": "(SCIN)",
            "free_txt": [
              " The neutron detector consisted of a 2.5 cm",
              "thick NE110 plastic scintillator."
            ]
          }
        ],
        "facility": [
          {
            "x4_code": "(LINAC,1USAORL)",
            "free_txt": [
              " The Oak Ridge Electron Linear",
              "Accelerator (ORELA)."
            ]
          }
        ],
        "inc-spect": [
          {
            "x4_code": null,
            "free_txt": [
              "The energy region extended from about 0.1 to 20 MeV",
              "using 80 m & 200 m flight paths and 10 ns electron beam",
              "width. The 2.3 cm diameter neutron beam was",
              "collimated to originate from tantalum portion of the",
              "target in order to reduce the gamma ray background",
              "produced in the water moderator."
            ]
          }
        ],
        "sample": [
          {
            "x4_code": null,
            "free_txt": [
              "Two samples were contained in 3.2",
              "cm diameter cylindrical holders with 0.5 cm thick",
              "tantalum end caps. The thickness in each sample of",
              "10B (0.2355 and 0.2349 atoms per barn)",
              "was determined",
              "from the dimensions of the precisely matched holder,",
              "the chemical analysis of the boron, and the weight of",
              "the material."
            ]
          }
        ],
        "status": [
          {
            "x4_code": "(APRVD)",
            "free_txt": [
              " Approved by A.D.Carlson on April 18, 2025."
            ]
          }
        ]
      }
    },
    "002": {
      "0": {
        "correction": [
          {
            "x4_code": null,
            "free_txt": [
              "The maximum dead time correction was approximately",
              "60% for the 80 m measurements due to a longer data",
              "gate in the acquisition system. Because of this large",
              "correction at 80 m, additional measurements using",
              "thick iron filters in the beam were done at this",
              "distance. The maximum dead time correction was",
              "reduced to less than 0.3%, although only",
              "approximately 20 neutron energy windows between 20",
              "and 600 keV were available for analysis."
            ]
          }
        ],
        "err-analys": [
          {
            "x4_code": "(ERR-S)",
            "free_txt": [
              " Statistical uncertainty."
            ]
          },
