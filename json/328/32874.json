        "sample": [
          {
            "x4_code": null,
            "free_txt": [
              "Natural tungsten foils of 3.01-3.14 mm thickness and",
              "99.95% purity were made into round foils of 20 mm",
              "diameter. Monitor foils (natural niobium foils, each",
              "1 mm in thickness, 99.95% purity) of the same",
              "diameter as the tungsten sample were attached in",
              "front of and behind each tungsten sample, which was",
              "wrapped in a pure cadmium foil (1 mm in thickness,",
              "99.95% purity) to reduce the effect of the",
              "180W(n,g)181W reaction induced by thermal neutrons",
              "on the 182W(n,2n)181W reaction."
            ]
          }
        ]
