            "x4_code": null,
            "free_txt": [
              "Author comment:",
              "The present simultaneous evaluation supersedes",
              " previous ones",
              "  (J.G.Hayes,T.B.Ryves Ann.Nucl.Energy 8(1981)469)",
              " compiled in EXFOR V0029;",
              "   G.Winkler,T.B.Ryves, Ann.Nucl.Energy 10(1983)601;",
              "   T.B.Ryves Rep.IAEA-TECDOC-335(1983)432)",
              " which included many of the same reactions, because the",
              " data base has been more than doubled and now includes",
              " a number of recent accurate measurements, the input",
              " data have been carefully revised, and many more",
              " correlations have been added."
            ]
